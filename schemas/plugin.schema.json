{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecializedPlugin",
  "description": "Schema for specialized plugin bundles in bundle-useful-skills",
  "type": "object",
  "required": [
    "id",
    "name",
    "plugin_name",
    "priority",
    "audience",
    "why",
    "skill_count",
    "skills"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "plugin_name": {
      "type": "string",
      "pattern": "^agentic-bundle-[a-z0-9-]+$"
    },
    "priority": {
      "type": "string",
      "enum": ["tier-1", "tier-2", "tier-3"]
    },
    "audience": {
      "type": "string",
      "minLength": 5
    },
    "why": {
      "type": "string",
      "minLength": 5
    },
    "skill_count": {
      "type": "integer",
      "minimum": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
