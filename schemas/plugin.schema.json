{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BundlePluginMetadata",
  "description": "Schema for focused bundle plugins within bundle-useful-skills",
  "type": "object",
  "required": [
    "id",
    "name",
    "plugin_name",
    "description",
    "job",
    "skills",
    "skill_count"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "plugin_name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 5
    },
    "job": {
      "type": "string",
      "minLength": 5
    },
    "skill_count": {
      "type": "integer",
      "minimum": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "recommended_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
